@@ -1361,10 +1408,24 @@ def evaluate_pending_outcomes(outcomes, stats, now):
         else:
             outcome = "flat"
 
+        # Path since the alert fired, from the running peak/trough
+        # update_pending_outcome_extremes() has been maintaining every
+        # cycle -- falls back to entry_price (0% MFE/MAE) for any entry
+        # that predates this field or was never updated (e.g. resolved on
