+def update_pending_outcome_extremes(outcomes):
+    """Called once per main scan cycle, BEFORE evaluate_pending_outcomes(),
+    for every still-open (unresolved) pending breakout outcome: fetches the
+    current price and updates the running peak/trough seen since the alert
+    fired.
+
+    Why this exists: evaluate_pending_outcomes() only ever looks at price
+    ONCE, exactly EVALUATION_HOURS after the alert -- so its win/loss/flat
+    verdict (and the pct_change shown in the OUTCOME message) reflects
+    wherever the price happened to be at that single moment, not the path
+    it took. A coin that spiked +12% and then reversed hard looks
+    identical, at that one snapshot, to one that fell straight through --
+    even though those are very different patterns for spotting a
+    spike-then-crash setup before entry. Tracking the running peak/trough
+    here (same per-cycle, get_current_price()-based pattern already used
+    by check_exit_levels() for real positions) lets the eventual OUTCOME
+    message report both, without needing to re-fetch historical candles
+    after the fact.
+
+    Best-effort: a failed price fetch for one product just leaves its
+    peak/trough unchanged for this cycle, same as evaluate_pending_outcomes
+    already does when fetch_candles fails."""
+    changed = False
+    for entry in outcomes.values():
+        if entry.get("resolved"):
+            continue
+        price = get_current_price(entry["product_id"])
+        time.sleep(REQUEST_PACING_SECONDS)
+        if price is None:
+            continue
+        entry_price = entry["entry_price"]
+        if price > entry.get("peak_price", entry_price):
+            entry["peak_price"] = price
+            changed = True
+        if price < entry.get("trough_price", entry_price):
+            entry["trough_price"] = price
+            changed = True
+    return outcomes, changed
+
+
 def evaluate_pending_outcomes(outcomes, stats, now):
